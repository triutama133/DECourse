{
  "name": "DataForge course",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/java:1": { "version": "17" },
    "ghcr.io/devcontainers/features/terraform:1": { "tflint": "none", "terragrunt": "none" },
    "ghcr.io/devcontainers/features/node:1": { "version": "20" }
  },
  "hostRequirements": { "cpus": 4, "memory": "8gb" },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postAttachCommand": "echo 'Open the Ports tab and click port 3000 after running: python3 server.py'",
  "forwardPorts": [3000],
  "portsAttributes": { "3000": { "label": "DataForge site", "onAutoForward": "notify" } },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "hashicorp.terraform", "redhat.vscode-yaml"],
      "settings": { "python.defaultInterpreterPath": "/usr/local/bin/python", "python.testing.pytestEnabled": true }
    }
  }
}
